{
  "name": "git-for-me",
  "version": "0.1.1",
  "description": "Git for me! Odds are, most of what you want to build is already open source. Tell your AI agent what you're making; it finds the repos on GitHub, GitLab and Codeberg, every one checked live.",
  "license": "MIT",
  "mcpName": "io.github.bikemeardsley/git-for-me",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bikemeardsley/git-for-me.git"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "github",
    "gitlab",
    "codeberg",
    "open-source",
    "claude-code",
    "agent-skills"
  ],
  "type": "module",
  "bin": {
    "git-for-me": "build/src/server.js"
  },
  "files": [
    "build/src"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "prepare": "tsc",
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  }
}
